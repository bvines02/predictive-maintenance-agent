# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Secrets - never commit real keys
.env

# Data and models are generated or downloaded, not source code
data/raw/*
data/processed/*
models/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!models/.gitkeep

# AI4I 2020 dataset is small (~500KB) and CC BY 4.0 - committed so a fresh
# clone works without a manual download step
!data/raw/ai4i2020.csv

# NASA C-MAPSS FD001 dataset (~5.7MB) - same reasoning as ai4i2020.csv above.
# FD001 only for now; FD002-FD004 stay ignored until V2 needs them.
!data/raw/cmapss/
!data/raw/cmapss/FD001/
!data/raw/cmapss/FD001/*.txt

# OS
.DS_Store
