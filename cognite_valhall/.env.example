# ---------------------------------------------------------------------------
# Copy to .env and adjust. .env is git-ignored; .env.example is committed.
#
# The defaults below are the PUBLIC identifiers for Cognite's Open Industrial
# Data project. They are not secrets -- they are published so that anyone can
# sign up and log in with their own account. You normally do not need to change
# any of them; the file exists so the values are visible and overridable.
#
# Sign up for access first: https://openindustrialdata.com
# ---------------------------------------------------------------------------

# --- Which CDF project and cluster ----------------------------------------
COGNITE_PROJECT=publicdata
COGNITE_BASE_URL=https://api.cognitedata.com
COGNITE_CLIENT_NAME=valhall-compressor-extractor

# --- Identity provider (Microsoft Entra ID / Azure AD) --------------------
# Tenant that hosts Open Industrial Data logins.
AZURE_TENANT_ID=48d5043c-cf70-4c49-881c-c638f5796997

# Public client registration published by Cognite for SDK logins. "Public" is
# an OAuth term: a client that cannot hold a secret, so it authenticates YOU
# interactively rather than authenticating itself.
COGNITE_CLIENT_ID=1b90ede3-271e-401b-81a0-a4d52bea3273

# --- How to authenticate --------------------------------------------------
# device_code  (default) prints a URL + short code to approve in any browser.
#              Works over SSH and inside containers. Recommended.
# interactive  opens a local browser redirect on localhost:53000. Needs a
#              browser on this machine.
# client_credentials  machine-to-machine; requires COGNITE_CLIENT_SECRET.
#              This is what a production extractor uses.
COGNITE_AUTH_FLOW=device_code

# ONLY for client_credentials. Never commit a real value.
# In production this comes from a secret manager, not a file.
# COGNITE_CLIENT_SECRET=

# Where the cached refresh token is stored. Treat this file as a secret --
# it is git-ignored. Delete it to force a fresh login.
# COGNITE_TOKEN_CACHE=.cognite_token_cache.json

# --- Extraction scope -----------------------------------------------------
VALHALL_TARGET_ASSET=23-KA-9101
VALHALL_LOOKBACK_DAYS=60
VALHALL_INCLUDE_SIBLINGS=true
VALHALL_ANCESTOR_DEPTH=6

# --- API batching ---------------------------------------------------------
# 100 is the CDF per-request limit for time series in a datapoints query.
VALHALL_TS_PER_REQUEST=100
# Days of data fetched per request window; bounds peak memory.
VALHALL_RAW_CHUNK_DAYS=7
VALHALL_MAX_RETRIES=8
VALHALL_MAX_RETRY_BACKOFF=60

# --- Safety rails ---------------------------------------------------------
# Above this estimated raw-point count the pipeline stops and asks.
VALHALL_LARGE_DOWNLOAD_THRESHOLD=50000000
# Hard cap on documents downloaded.
VALHALL_MAX_FILES=60
